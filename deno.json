{
  "name": "@halvardm/comicinfo",
  "version": "0.2.0",
  "exports": {
    ".": "./mod.ts",
    "./v1": "./v1_0.ts",
    "./v2": "./v2_0.ts",
    "./v2_1": "./v2_1.ts"
  },
  "tasks": {
    "dev": "deno test --watch",
    "test": "deno test --coverage=coverage",
    "coverage": "deno coverage coverage",
    "fix": "deno fmt && deno lint --fix",
    "check": "deno fmt --check && deno lint && deno check"
  },
  "license": "MIT",
  "imports": {
    "@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
    "@std/assert": "jsr:@std/assert@1",
    "@stdext/xml": "jsr:@stdext/xml@^0.1.1",
    "@stdext/validation": "jsr:@stdext/validation@^0.1.0",
    "@stdext/types": "jsr:@stdext/types@^0",
    "@zod/zod": "jsr:@zod/zod@^4.5.2"
  },
  "lock": false,
  "lint": {
    "rules": {
      "exclude": ["no-slow-types"]
    }
  },
  "minimumDependencyAge": { "exclude": ["jsr:@stdext/*"] }
}
